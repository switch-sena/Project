<!DOCTYPE html>
<html>

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <title>Registration Form</title>
    <link rel="stylesheet" href="http://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/Content/styles.css">
</head>

<body>
    <div class="container" id="registration-form">
        <div class="image"></div>
        <div class="frm">
            <h1>Registro</h1>
            <form>
                <div class="form-group">
                    <label for="username">Nombre:</label>
                    <input type="text" class="form-control" id="username" placeholder="Introduzca nombre">
                </div>
                <div class="form-group">
                    <label for="email">Correo:</label>
                    <input type="email" class="form-control" id="email" placeholder="Introduzca correo">
                </div>
                <div class="form-group">
                    <label for="pwd">Contraseña:</label>
                    <input type="password" class="form-control" id="pwd" placeholder="Introduzca contraseña">
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-info btn-lg text-white" >Registrarse</button>
                </div>
            </form>
        </div>
    </div>
</body>

</html>
