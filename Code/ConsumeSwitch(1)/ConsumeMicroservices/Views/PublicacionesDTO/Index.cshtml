@model IEnumerable<ConsumeMicroservices.Models.PublicacionesDTO>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>

<!-- Start Content -->
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card mb-4 product-wap rounded-0">
                <div class="card rounded-0">
                    <!-- Imagen dinámica -->
                    <img class="card-img rounded-0 img-fluid" src="/img/shop_01.jpg" alt="Product Image">

                    <div class="card-img-overlay rounded-0 product-overlay d-flex align-items-center justify-content-center">
                        <ul class="list-unstyled">
                            <li>
                                @Html.ActionLink(
                                    "PublicacionesDTO",
                                    "Contact",
                                    "Home",
                                    new { id = item.IdPubl },
                                    new { @class = "btn btn-info text-white mt-2 far fa-eye" })
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Titulo de la publicación -->
                    <a href="@Url.Action("ShopSingle", "Home", new { id = item.IdPubl })" class="h3 text-decoration-none">@Html.DisplayFor(modelItem => item.TituloPubl)</a>

                    <!-- Descripción de la publicación -->
                    <p class="card-text">@Html.DisplayFor(modelItem => item.Habilidades)</p>
                    <p class="card-text">@Html.DisplayFor(modelItem => item.Modalidades)</p>

                    <p class="card-text"><strong>@Html.DisplayFor(modelItem => item.NombreUsuario)</strong></p>

                    <!-- Acciones (Editar, Detalles, Eliminar) -->
                </div>
            </div>
        </div>
    }
</div>
<!-- End Content -->
