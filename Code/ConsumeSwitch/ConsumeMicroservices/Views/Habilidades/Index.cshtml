@model IEnumerable<ConsumeMicroservices.Models.Habilidades>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.NombreHabi)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DescripcionHabi)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.NombreHabi)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DescripcionHabi)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.IdHabi }) |
            @Html.ActionLink("Details", "Details", new { id=item.IdHabi }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.IdHabi })
        </td>
    </tr>
}

</table>
