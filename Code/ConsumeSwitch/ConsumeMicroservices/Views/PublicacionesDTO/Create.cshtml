@model ConsumeMicroservices.Models.PublicacionesDTO

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>

@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
<div class="form-horizontal">
    <h4>PublicacionesDTO</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @Html.HiddenFor(model => model.IdPubl)

    <div class="form-group">
        @Html.LabelFor(model => model.TituloPubl, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.TituloPubl, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.TituloPubl, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.DescripcionPubl, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.DescripcionPubl, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.DescripcionPubl, "", new { @class = "text-danger" })
        </div>
    </div>

    @Html.HiddenFor(model => model.CopiaIdUsua)

    <!-- Habilidades -->
    <div class="form-group">
        @Html.LabelFor(model => model.IdHabi, "Habilidades", new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.IdHabi, ViewBag.NombreHabi as SelectList, "Seleccione una habilidad", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.IdHabi, "", new { @class = "text-danger" })
        </div>
    </div>

    <!-- Modalidades -->
    <div class="form-group">
        @Html.LabelFor(model => model.IdModa, "Modalidades", new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.IdModa, ViewBag.NombreModa as SelectList, "Seleccione una modalidad", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.IdModa, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Create" class="btn btn-info" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>
