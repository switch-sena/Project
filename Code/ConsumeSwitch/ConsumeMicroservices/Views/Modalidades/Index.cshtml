@model IEnumerable<ConsumeMicroservices.Models.Modalidades>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.NombreModa)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DescripcionModa)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.NombreModa)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DescripcionModa)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.IdModa }) |
            @Html.ActionLink("Details", "Details", new { id=item.IdModa }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.IdModa })
        </td>
    </tr>
}

</table>
