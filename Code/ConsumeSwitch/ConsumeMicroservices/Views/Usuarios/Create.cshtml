
@model ConsumeMicroservices.Models.Usuarios

@{
    ViewBag.Title = "Crear Usuario";
}
@{
    Layout = null;
}


@Styles.Render("~/Content/css")
@Scripts.Render("~/bundles/modernizr")
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
@Scripts.Render("~/bundles/jqueryval")
<script src="https://unpkg.com/popperjs/core@2"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" type="text/css" />
<link href="https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="http://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
<link rel="stylesheet" type="text/css" href="~/Content/Registrousuario.css">

@using (Html.BeginForm("Create", "Usuarios", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="container" id="registration-form">
        <h1>Registro de Usuario</h1>

        <div class="form-horizontal">
            <h4>Registrar Nuevo Usuario</h4>
            <hr />

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <!-- Nombre -->
            <div class="form-group">
                <label for="NombreUsua" class="control-label col-md-2">Nombre:</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.NombreUsua, new { htmlAttributes = new { @class = "form-control", placeholder = "Introduzca nombre" } })
                    @Html.ValidationMessageFor(model => model.NombreUsua, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Apellido -->
            <div class="form-group">
                <label for="ApellidoUsua" class="control-label col-md-2">Apellido:</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.ApellidoUsua, new { htmlAttributes = new { @class = "form-control", placeholder = "Introduzca apellido" } })
                    @Html.ValidationMessageFor(model => model.ApellidoUsua, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Correo -->
            <div class="form-group">
                <label for="CorreoUsua" class="control-label col-md-2">Correo:</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.CorreoUsua, new { htmlAttributes = new { @class = "form-control", placeholder = "Introduzca correo" } })
                    @Html.ValidationMessageFor(model => model.CorreoUsua, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Contraseña -->
            <div class="form-group">
                <label for="ClaveUsua" class="control-label col-md-2">Contraseña:</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.ClaveUsua, new { htmlAttributes = new { @class = "form-control", placeholder = "Introduzca contraseña" } })
                    @Html.ValidationMessageFor(model => model.ClaveUsua, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Celular -->
            <div class="form-group">
                <label for="CelularUsua" class="control-label col-md-2">Celular:</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.CelularUsua, new { htmlAttributes = new { @class = "form-control", placeholder = "Introduzca celular" } })
                    @Html.ValidationMessageFor(model => model.CelularUsua, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Fecha de Nacimiento -->
            <div class="form-group">
                <label for="FechaNacimientoUsua" class="control-label col-md-2">Fecha de Nacimiento:</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.FechaNacimientoUsua, new { htmlAttributes = new { @class = "form-control", placeholder = "Introduzca fecha de nacimiento" } })
                    @Html.ValidationMessageFor(model => model.FechaNacimientoUsua, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Género -->
            <div class="form-group">
                <label for="GeneroUsua" class="control-label col-md-2">Género:</label>
                <div class="col-md-10">
                    @Html.EditorFor(model => model.GeneroUsua, new { htmlAttributes = new { @class = "form-control", placeholder = "Introduzca género" } })
                    @Html.ValidationMessageFor(model => model.GeneroUsua, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Enviar Fecha de Creación y Modificación (ocultos) -->
            <div class="form-group">
                <div class="col-md-10">
                    @Html.HiddenFor(model => model.CreacionFechaUsua)
                    @Html.HiddenFor(model => model.ModificacionFechaUsua)
                </div>
            </div>

            <!-- Botón de Enviar -->
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <button type="submit" class="btn btn-info btn-lg text-white">Registrarse</button>
                </div>
            </div><!-- Enlace "Volver a la lista" -->
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-default btn-lg" })
                </div>
            </div>
        </div>
    </div>
}

