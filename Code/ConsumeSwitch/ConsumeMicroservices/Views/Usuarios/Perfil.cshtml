@model ConsumeMicroservices.Models.UsuariosDTO

@{
    ViewBag.Title = "Perfil";
}

<head>
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <link href="~/lib/lightbox/css/lightbox.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/Content/Inicio/Perfil.css" rel="stylesheet">
    <link href="~/Content/Inicio/Perfil1.css" rel="stylesheet">
    <link href="~/Content/Inicio/Perfil2.css" rel="stylesheet">
</head>
<body>
    <!-- Header End -->
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-6 mx-auto">
                <div class="bg-light p-5 rounded shadow-sm">
                    <h2 class="text-center text-uppercase text-primary mb-4">Perfil</h2>
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(model => model.IdUsua)

                        <div class="form-group">
                            @Html.LabelFor(model => model.NombreUsua, htmlAttributes: new { @class = "font-weight-bold" })
                            @Html.EditorFor(model => model.NombreUsua, new { htmlAttributes = new { @class = "form-control border-0 shadow-sm" } })
                            @Html.ValidationMessageFor(model => model.NombreUsua, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.ApellidoUsua, htmlAttributes: new { @class = "font-weight-bold" })
                            @Html.EditorFor(model => model.ApellidoUsua, new { htmlAttributes = new { @class = "form-control border-0 shadow-sm" } })
                            @Html.ValidationMessageFor(model => model.ApellidoUsua, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.GeneroUsua, htmlAttributes: new { @class = "font-weight-bold" })
                            @Html.EditorFor(model => model.GeneroUsua, new { htmlAttributes = new { @class = "form-control border-0 shadow-sm" } })
                            @Html.ValidationMessageFor(model => model.GeneroUsua, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold text-primary" for="FechaNacimientoUsua">Fecha de Nacimiento</label>
                            @Html.EditorFor(model => model.FechaNacimientoUsua, new { htmlAttributes = new { @class = "form-control border-0 shadow-sm", @id = "FechaNacimientoUsua" } })
                            @Html.ValidationMessageFor(model => model.FechaNacimientoUsua, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold text-primary" for="CelularUsua">Celular</label>
                            @Html.EditorFor(model => model.CelularUsua, new { htmlAttributes = new { @class = "form-control border-0 shadow-sm", @id = "CelularUsua" } })
                            @Html.ValidationMessageFor(model => model.CelularUsua, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold text-primary" for="CorreoUsua">Correo Electrónico</label>
                            @Html.EditorFor(model => model.CorreoUsua, new { htmlAttributes = new { @class = "form-control border-0 shadow-sm", @id = "CorreoUsua" } })
                            @Html.ValidationMessageFor(model => model.CorreoUsua, "", new { @class = "text-danger small" })
                        </div>

                        @Html.HiddenFor(model => model.ClaveUsua)

                        <div class="form-group">
                            <label class="font-weight-bold text-primary" for="CorreoElectronicoUsua">Correo Electrónico</label>
                            @Html.EditorFor(model => model.CorreoElectronicoUsua, new { htmlAttributes = new { @class = "form-control border-0 shadow-sm", @id = "CorreoElectronicoUsua", @placeholder = "Ingrese su correo electrónico" } })
                            @Html.ValidationMessageFor(model => model.CorreoElectronicoUsua, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold text-primary" for="LinksRsUsua">Enlaces a Redes Sociales</label>
                            @Html.EditorFor(model => model.LinksRsUsua, new { htmlAttributes = new { @class = "form-control border-0 shadow-sm", @id = "LinksRsUsua", @placeholder = "Ingrese sus enlaces a redes sociales" } })
                            @Html.ValidationMessageFor(model => model.LinksRsUsua, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group">
                            <label for="IdBarr" class="font-weight-bold text-primary">Barrio</label>
                            @Html.DropDownListFor(model => model.IdBarr, ViewBag.NombreBarr as SelectList, new { @class = "form-control border-0 shadow-sm", @id = "IdBarr" })
                            @Html.ValidationMessageFor(model => model.IdBarr, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group">
                            <div class="col-md-10 offset-md-2">
                                <input type="submit" value="Guardar" class="btn btn-primary btn-lg w-100" />
                            </div>
                        </div>
                    }
                    <div class="text-center mt-3">
                        @Html.ActionLink("Volver a la lista", "Index", "PublicacionesDTO", new { @class = "btn btn-outline-primary" })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Scroll to Bottom -->
    <i class="fa fa-2x fa-angle-down text-white scroll-to-bottom"></i>

    <!-- Back to Top -->
    <a href="#" class="btn btn-outline-dark px-0 back-to-top"><i class="fa fa-angle-double-up"></i></a>


    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/typed/typed.min.js"></script>
    <script src="~/lib/easing/easing.min.js"></script>
    <script src="~/lib/waypoints/waypoints.min.js"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/lib/isotope/isotope.pkgd.min.js"></script>
    <script src="~/lib/lightbox/js/lightbox.js"></script>

    <!-- Template Javascript -->
    <script src="~/Scripts/scripts.js"></script>
</body>
